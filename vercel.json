{
 "buildCommand":"npm run build:site",
 "outputDirectory":"public",
 "framework":null,
 "rewrites":[{"source":"/api/:path*","destination":"/api/trainer?__trainer_route=:path*"}],
 "functions":{"api/**/*.js":{"maxDuration":30}},
 "headers":[
  {"source":"/api/(.*)","headers":[{"key":"Cache-Control","value":"no-store"}]},
  {"source":"/assets/accounts.js","headers":[{"key":"Cache-Control","value":"public, max-age=86400"}]},
  {"source":"/js/arcade.js","headers":[{"key":"Cache-Control","value":"public, max-age=86400"}]},
  {"source":"/css/premium.css","headers":[{"key":"Cache-Control","value":"public, max-age=86400"}]},
  {"source":"/css/arcade.css","headers":[{"key":"Cache-Control","value":"public, max-age=86400"}]},
  {"source":"/css/accounts.css","headers":[{"key":"Cache-Control","value":"public, max-age=86400"}]}
 ]
}
